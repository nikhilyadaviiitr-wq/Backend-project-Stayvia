<%- include("../partials/head") %>
<%- include("../partials/nav") %>

<main class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 py-10">

  <!-- Signup Card -->
  <section
    class="relative w-full max-w-[560px] overflow-hidden
           rounded-3xl
           border border-white/10
           bg-white/[0.055]
           backdrop-blur-2xl
           shadow-[0_25px_80px_rgba(0,0,0,0.45)]
           px-7 py-9 sm:px-9 sm:py-10"
  >

    <!-- Decorative Glow -->
    <div
      class="pointer-events-none absolute -top-28 -right-28
             h-56 w-56 rounded-full
             bg-purple-600/20 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -bottom-28 -left-28
             h-56 w-56 rounded-full
             bg-cyan-400/10 blur-3xl"
    ></div>


    <!-- Header -->
    <div class="relative mb-8 text-center">

      <h1
        class="text-3xl sm:text-[34px]
               font-extrabold tracking-tight
               bg-gradient-to-r
               from-purple-300
               via-blue-300
               to-cyan-300
               bg-clip-text text-transparent"
      >
        Create Your Account
      </h1>

      <p
        class="mt-3 text-sm leading-6
               text-purple-100/65"
      >
        Join us and start exploring amazing stays.
      </p>

    </div>


    <!-- Error Messages -->
    <% if (typeof errorMessages !== "undefined" && errorMessages && errorMessages.length > 0) { %>

      <div
        class="relative mb-6
               rounded-xl
               border border-red-400/20
               bg-red-500/10
               px-4 py-3"
      >

        <ul class="space-y-1 text-sm text-red-200">

          <% errorMessages.forEach(error => { %>

            <li class="flex items-start gap-2">
              <span class="mt-1 shrink-0">•</span>
              <span><%= error %></span>
            </li>

          <% }); %>

        </ul>

      </div>

    <% } %>


    <!-- Signup Form -->
    <form
      action="/signup"
      method="POST"
      class="relative space-y-5"
    >


      <!-- First + Last Name -->
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">

        <!-- First Name -->
        <div>

          <label
            for="FirstName"
            class="mb-2 block
                   text-sm font-medium
                   text-purple-100/90"
          >
            First Name
          </label>

          <input
            type="text"
            name="FirstName"
            id="FirstName"
            placeholder="Nikhil"
            required
            class="w-full rounded-xl
                   border border-purple-400/25
                   bg-black/15
                   px-4 py-3.5
                   text-sm text-white
                   placeholder:text-purple-100/35
                   outline-none
                   transition-all duration-200
                   hover:border-purple-400/45
                   focus:border-cyan-300/70
                   focus:bg-black/20
                   focus:ring-4
                   focus:ring-cyan-300/10"
          />

        </div>


        <!-- Last Name -->
        <div>

          <label
            for="LastName"
            class="mb-2 block
                   text-sm font-medium
                   text-purple-100/90"
          >
            Last Name
          </label>

          <input
            type="text"
            name="LastName"
            id="LastName"
            placeholder="Yadav"
            required
            class="w-full rounded-xl
                   border border-purple-400/25
                   bg-black/15
                   px-4 py-3.5
                   text-sm text-white
                   placeholder:text-purple-100/35
                   outline-none
                   transition-all duration-200
                   hover:border-purple-400/45
                   focus:border-cyan-300/70
                   focus:bg-black/20
                   focus:ring-4
                   focus:ring-cyan-300/10"
          />

        </div>

      </div>


      <!-- Email -->
      <div>

        <label
          for="Email"
          class="mb-2 block
                 text-sm font-medium
                 text-purple-100/90"
        >
          Email
        </label>

        <input
          type="email"
          name="Email"
          id="Email"
          placeholder="eg: xyz123@gmail.com"
          required
          autocomplete="email"
          class="w-full rounded-xl
                 border border-purple-400/25
                 bg-black/15
                 px-4 py-3.5
                 text-sm text-white
                 placeholder:text-purple-100/35
                 outline-none
                 transition-all duration-200
                 hover:border-purple-400/45
                 focus:border-cyan-300/70
                 focus:bg-black/20
                 focus:ring-4
                 focus:ring-cyan-300/10"
        />

      </div>


      <!-- Password -->
      <div>

        <label
          for="Password"
          class="mb-2 block
                 text-sm font-medium
                 text-purple-100/90"
        >
          Password
        </label>

        <input
          type="password"
          name="Password"
          id="Password"
          required
          autocomplete="new-password"
          placeholder="Create a strong password"
          class="w-full rounded-xl
                 border border-purple-400/25
                 bg-black/15
                 px-4 py-3.5
                 text-sm text-white
                 placeholder:text-purple-100/35
                 outline-none
                 transition-all duration-200
                 hover:border-purple-400/45
                 focus:border-cyan-300/70
                 focus:bg-black/20
                 focus:ring-4
                 focus:ring-cyan-300/10"
        />

      </div>


      <!-- Confirm Password -->
      <div>

        <label
          for="ConfirmPassword"
          class="mb-2 block
                 text-sm font-medium
                 text-purple-100/90"
        >
          Confirm Password
        </label>

        <input
          type="password"
          name="ConfirmPassword"
          id="ConfirmPassword"
          required
          autocomplete="new-password"
          placeholder="Re-enter your password"
          class="w-full rounded-xl
                 border border-purple-400/25
                 bg-black/15
                 py-3.5 px-4
                 text-sm text-white
                 placeholder:text-purple-100/35
                 outline-none
                 transition-all duration-200
                 hover:border-purple-400/45
                 focus:border-cyan-300/70
                 focus:bg-black/20
                 focus:ring-4
                 focus:ring-cyan-300/10"
        />

      </div>


      <!-- User Type -->
      <div class="pt-1">

        <p
          class="mb-3 text-sm font-medium
                 text-purple-100/90"
        >
          I want to register as:
        </p>


        <div class="grid grid-cols-2 gap-4">


          <!-- Guest -->
          <label
            for="Guest"
            class="group cursor-pointer"
          >

            <input
              type="radio"
              name="UserType"
              id="Guest"
              value="Guest"
              required
              class="peer sr-only"
            />

            <div
              class="rounded-xl
                     border border-purple-400/20
                     bg-black/10
                     px-4 py-4
                     text-center
                     transition-all duration-200
                     hover:border-purple-400/45
                     hover:bg-purple-500/10
                     peer-checked:border-cyan-300/70
                     peer-checked:bg-cyan-400/10
                     peer-checked:shadow-[0_0_20px_rgba(34,211,238,0.08)]"
            >

              <div
                class="mx-auto mb-2 flex h-10 w-10
                       items-center justify-center
                       rounded-full
                       bg-purple-500/10
                       text-purple-300"
              >

                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                >

                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"
                  />

                  <circle
                    cx="9"
                    cy="7"
                    r="4"
                  />

                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 8v6M22 11h-6"
                  />

                </svg>

              </div>

              <span
                class="text-sm font-semibold
                       text-purple-100/80"
              >
                Guest
              </span>

              <p
                class="mt-1 text-xs
                       text-purple-100/40"
              >
                Find your next stay
              </p>

            </div>

          </label>


          <!-- Host -->
          <label
            for="Host"
            class="group cursor-pointer"
          >

            <input
              type="radio"
              name="UserType"
              id="Host"
              value="Host"
              required
              class="peer sr-only"
            />

            <div
              class="rounded-xl
                     border border-purple-400/20
                     bg-black/10
                     px-4 py-4
                     text-center
                     transition-all duration-200
                     hover:border-purple-400/45
                     hover:bg-purple-500/10
                     peer-checked:border-cyan-300/70
                     peer-checked:bg-cyan-400/10
                     peer-checked:shadow-[0_0_20px_rgba(34,211,238,0.08)]"
            >

              <div
                class="mx-auto mb-2 flex h-10 w-10
                       items-center justify-center
                       rounded-full
                       bg-purple-500/10
                       text-purple-300"
              >

                <svg
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  viewBox="0 0 24 24"
                >

                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M3 21h18"
                  />

                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M5 21V8l7-4 7 4v13"
                  />

                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M9 21v-6h6v6"
                  />

                  <path
                    stroke-linecap="round"
                    d="M9 9h.01M15 9h.01"
                  />

                </svg>

              </div>

              <span
                class="text-sm font-semibold
                       text-purple-100/80"
              >
                Host
              </span>

              <p
                class="mt-1 text-xs
                       text-purple-100/40"
              >
                Share your property
              </p>

            </div>

          </label>

        </div>

      </div>


      <!-- Terms & Conditions -->
      <div class="pt-1">

        <label
          for="TC"
          class="group flex w-full cursor-pointer items-start gap-3
                 rounded-xl
                 border border-purple-400/20
                 bg-black/10
                 px-4 py-4
                 text-sm text-purple-100/70
                 transition-all duration-200
                 hover:border-purple-400/40
                 hover:bg-purple-500/5"
        >

          <!-- Real Checkbox -->
          <input
            type="checkbox"
            name="TC"
            id="TC"
            required
            class="peer sr-only"
          />

          <!-- Custom Checkbox -->
          <span
            class="mt-0.5 flex h-5 w-5 min-h-5 min-w-5 shrink-0
                   items-center justify-center
                   rounded-md
                   border border-purple-400/40
                   bg-white/5
                   transition-all duration-200
                   peer-checked:border-cyan-300
                   peer-checked:bg-gradient-to-br
                   peer-checked:from-purple-500
                   peer-checked:to-cyan-400
                   peer-checked:shadow-[0_0_12px_rgba(34,211,238,0.25)]"
          >
            <span
              class="hidden peer-checked:flex items-center justify-center text-xs font-bold text-white"
            >
              ✓
            </span>
          </span>

          <!-- Terms Text -->
          <span
            class="min-w-0 flex-1
                   break-normal text-left
                   leading-6"
          >
            I agree to the

            <a
              href="#"
              class="font-semibold
                     text-purple-300
                     transition-colors duration-200
                     hover:text-cyan-300"
              onclick="event.stopPropagation();"
            >
              Terms and Conditions
            </a>

            and

            <a
              href="#"
              class="font-semibold
                     text-purple-300
                     transition-colors duration-200
                     hover:text-cyan-300"
              onclick="event.stopPropagation();"
            >
              Privacy Policy
            </a>

          </span>

        </label>

      </div>


      <!-- Sign Up Button -->
      <button
        type="submit"
        class="group relative
               w-full overflow-hidden
               rounded-xl
               bg-gradient-to-r
               from-purple-600
               via-violet-500
               to-cyan-400
               py-3.5
               text-base font-bold
               text-slate-950
               shadow-[0_8px_30px_rgba(124,58,237,0.25)]
               transition-all duration-300
               hover:-translate-y-0.5
               hover:shadow-[0_12px_35px_rgba(124,58,237,0.4)]
               active:translate-y-0"
      >

        <span
          class="relative z-10
                 flex items-center
                 justify-center gap-2"
        >

          <svg
            class="h-5 w-5
                   transition-transform duration-300
                   group-hover:scale-110"
            viewBox="0 0 20 20"
            fill="currentColor"
          >

            <path
              d="M10 1.6l8.5 7.1a1 1 0 01-1.2 1.6l-.3-.2V18a1 1 0 01-1 1h-3.5V13A2.5 2.5 0 009.5 10.5h-1A2.5 2.5 0 006 13v6H2.5a1 1 0 01-1-1V10.1l-.3.2A1 1 0 01.5 8.7L9 1.6a1 1 0 011 0z"
            />

          </svg>

          Create Account

          <svg
            class="h-4 w-4
                   transition-transform duration-300
                   group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14M13 6l6 6-6 6"
            />

          </svg>

        </span>

      </button>

    </form>


    <!-- Login Link -->
    <div
      class="relative mt-7
             border-t border-white/[0.07]
             pt-6
             text-center
             text-sm
             text-purple-100/55"
    >

      Already have an account?

      <a
        href="/login"
        class="ml-1
               font-semibold
               text-white
               transition-colors duration-200
               hover:text-cyan-300"
      >
        Sign in
      </a>

    </div>

  </section>

</main>