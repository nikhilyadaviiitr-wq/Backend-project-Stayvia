<%- include("../partials/head") %>
<%- include("../partials/nav") %>
</header>

<main class="min-h-[calc(100vh-80px)] flex items-center justify-center px-4 py-10">

  <!-- Login Card -->
  <section
    class="relative w-full max-w-[470px] overflow-hidden
           rounded-3xl
           border border-white/10
           bg-white/[0.055]
           backdrop-blur-2xl
           shadow-[0_25px_80px_rgba(0,0,0,0.45)]
           px-7 py-9 sm:px-9 sm:py-10"
  >

    <!-- Decorative Glow -->
    <div
      class="pointer-events-none absolute -top-24 -right-24
             h-48 w-48 rounded-full
             bg-purple-600/20 blur-3xl"
    ></div>

    <div
      class="pointer-events-none absolute -bottom-24 -left-24
             h-48 w-48 rounded-full
             bg-cyan-400/10 blur-3xl"
    ></div>


    <!-- Header -->
    <div class="relative flex flex-col items-center text-center">

      <h1
        class="text-3xl sm:text-[34px]
               font-extrabold tracking-tight
               bg-gradient-to-r
               from-purple-300
               via-blue-300
               to-cyan-300
               bg-clip-text text-transparent"
      >
        Welcome Back
      </h1>

      <p
        class="mt-3 max-w-sm
               text-sm leading-6
               text-purple-100/65"
      >
        Sign in to manage your bookings and favourites.
      </p>

    </div>


    <!-- Error Messages -->
    <% if (typeof errorMessages !== 'undefined' && errorMessages && errorMessages.length > 0) { %>

      <div
        class="relative mt-6
               rounded-xl
               border border-red-400/20
               bg-red-500/10
               px-4 py-3"
      >

        <ul class="space-y-1 text-sm text-red-200">

          <% errorMessages.forEach(error => { %>

            <li class="flex items-start gap-2">
              <span class="mt-1">•</span>
              <span><%= error %></span>
            </li>

          <% }); %>

        </ul>

      </div>

    <% } %>


    <!-- Login Form -->
    <form
      action="/login"
      method="POST"
      class="relative mt-8 space-y-5"
    >


      <!-- Email -->
      <div>

        <label
          for="email"
          class="mb-2 block
                 text-sm font-medium
                 text-purple-100/90"
        >
          Email
        </label>

        <div class="relative">

          <!-- Email Icon -->
          <svg
            class="pointer-events-none
                   absolute left-4 top-1/2 z-10
                   h-5 w-5
                   -translate-y-1/2
                   text-purple-300/80"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >

            <rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="2"
            ></rect>

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3 7l9 6 9-6"
            />

          </svg>


          <!-- Email Input -->
          <input
            id="email"
            type="email"
            name="Email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            style="padding-left: 60px;"
            class="w-full rounded-xl
                   border border-purple-400/25
                   bg-black/15
                   py-3.5 pr-4
                   text-sm text-white
                   placeholder:text-purple-100/35
                   outline-none
                   transition-all duration-200
                   hover:border-purple-400/45
                   focus:border-cyan-300/70
                   focus:bg-black/20
                   focus:ring-4 focus:ring-cyan-300/10"
          />

        </div>

      </div>


      <!-- Password -->
      <div>

        <label
          for="password"
          class="mb-2 block
                 text-sm font-medium
                 text-purple-100/90"
        >
          Password
        </label>

        <div class="relative">

          <!-- Lock Icon -->
          <svg
            class="pointer-events-none
                   absolute left-4 top-1/2 z-10
                   h-5 w-5
                   -translate-y-1/2
                   text-purple-300/80"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            viewBox="0 0 24 24"
          >

            <rect
              x="4"
              y="10"
              width="16"
              height="11"
              rx="2"
            ></rect>

            <path
              stroke-linecap="round"
              d="M8 10V7a4 4 0 018 0v3"
            />

          </svg>


          <!-- Password Input -->
          <input
            id="password"
            type="password"
            name="Password"
            required
            autocomplete="current-password"
            placeholder="Your password"
            style="padding-left: 60px;"
            class="w-full rounded-xl
                   border border-purple-400/25
                   bg-black/15
                   py-3.5 pr-4
                   text-sm text-white
                   placeholder:text-purple-100/35
                   outline-none
                   transition-all duration-200
                   hover:border-purple-400/45
                   focus:border-cyan-300/70
                   focus:bg-black/20
                   focus:ring-4 focus:ring-cyan-300/10"
          />

        </div>

      </div>


      <!-- Remember + Forgot -->
      <div
        class="flex items-center
               justify-between
               pt-1"
      >

        <label
          class="flex cursor-pointer
                 items-center gap-2.5
                 text-sm
                 text-purple-100/65"
        >

          <input
            type="checkbox"
            name="remember"
            class="h-4 w-4
                   cursor-pointer
                   rounded
                   border-purple-400/30
                   bg-white/5
                   accent-purple-500"
          />

          <span>Remember me</span>

        </label>


        <a
          href="#"
          class="text-sm
                 font-medium
                 text-purple-300
                 transition-colors duration-200
                 hover:text-cyan-300"
        >
          Forgot password?
        </a>

      </div>


      <!-- Sign In Button -->
      <button
        type="submit"
        class="group relative
               w-full
               overflow-hidden
               rounded-xl
               bg-gradient-to-r
               from-purple-600
               via-violet-500
               to-cyan-400
               py-3.5
               text-base
               font-bold
               text-slate-950
               shadow-[0_8px_30px_rgba(124,58,237,0.25)]
               transition-all duration-300
               hover:-translate-y-0.5
               hover:shadow-[0_12px_35px_rgba(124,58,237,0.4)]
               active:translate-y-0"
      >

        <span
          class="relative z-10
                 flex items-center
                 justify-center gap-2"
        >

          Sign in

          <svg
            class="h-4 w-4
                   transition-transform duration-300
                   group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
          >

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M5 12h14M13 6l6 6-6 6"
            />

          </svg>

        </span>

      </button>

    </form>


    <!-- Signup -->
    <div
      class="relative mt-7
             border-t border-white/[0.07]
             pt-6
             text-center
             text-sm
             text-purple-100/55"
    >

      Don't have an account?

      <a
        href="/signup"
        class="ml-1
               font-semibold
               text-white
               transition-colors duration-200
               hover:text-cyan-300"
      >
        Create one
      </a>

    </div>

  </section>

</main>